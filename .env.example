
# =========================
# LLM Configuration
# =========================

# Available providers: mock, ollama, openai
LLM_PROVIDER=ollama

# Enable mock mode without calling an LLM
USE_MOCK_LLM=false

# =========================
# OpenAI Configuration
# =========================

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=

# =========================
# Ollama Configuration
# =========================

# Ollama running on the host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model must be installed locally
OLLAMA_MODEL=qwen3:8b

# =========================
# Chroma Configuration
# =========================

# Chroma service name in Docker Compose
CHROMA_HOST=chroma
CHROMA_PORT=8000
